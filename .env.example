# --- Proxy AI opsional (server/ai-proxy.mjs) — JANGAN commit kunci asli ---
# Kredensial dibaca oleh SDK di sisi server. Alternatif: profil `ant auth login`.
ANTHROPIC_API_KEY=
# Model yang dipakai proxy (default claude-opus-5-5).
AI_MODEL=claude-opus-5-5
# Port proxy (default 8787; vite.config.ts mem-proxy /api/ai ke port ini saat dev).
AI_PROXY_PORT=8787

# --- Frontend (opsional) ---
# URL endpoint proxy bila tidak memakai proxy Vite (mis. saat hosting statis).
# VITE_AI_PROXY_URL=https://contoh-server-anda/api/ai
